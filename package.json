{
  "name": "cypress-e2e",
  "version": "1.0.0",
  "description": "Cypress E2E automation framework with TypeScript and Page Object Model",
  "scripts": {
    "open:runner": "cypress open",
    "demoQA:api": "cypress run --spec \"cypress/e2e/DemoQA/API/*.spec.ts\"",
    "demoQA:sanity": "cypress run --spec \"cypress/e2e/DemoQA/Sanity/*.spec.ts\"",
    "demoQA:e2e": "cypress run --spec \"cypress/e2e/DemoQA/E2E/*.spec.ts\"",
    "demoQA:all": "cypress run --spec \"cypress/e2e/DemoQA/**/*.spec.ts\""
  },
  "author": "Shteliyan Shiderov",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "cypress": "^13.15.0",
    "typescript": "^5.5.0"
  }
}
